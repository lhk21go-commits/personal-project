<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ page import="java.util.*" import="java.sql.*" %>    
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>회원가입하기</title>
</head>
<body>
	<h1>회원 가입 하기</h1>
<%
	request.setCharacterEncoding("utf-8");
		
	/* form에서 정보 추출 */
	String id = request.getParameter("id");
	String pass = request.getParameter("pass");
	String passchk = request.getParameter("passchk");
	String email = request.getParameter("email");
	String tel = request.getParameter("tel");
	String[] hobby = request.getParameterValues("hobby");
	String hobbies = "";
	if(hobby != null){
		for(int i=0; i<hobby.length; i++){
			hobbies += hobby[i] + " ";
		}
		hobbies = hobbies.trim();
	}
	String job = request.getParameter("job");		
	String age = request.getParameter("age");		
	String info = request.getParameter("info");		
	
	//DB 연동 시작 --------------------------------------
	Connection con = null;
	PreparedStatement pstmt = null;
	ResultSet rs = null;
	boolean idChk = false;
	
	String driver = "com.mysql.cj.jdbc.Driver";
	String url = "jdbc:mysql://localhost:3306/jspdb?serverTimezone=UTC&useSSL=false";
	String user = "root";
	String password = "1234";
	
	try{
		/* 드라이버 로딩  */
		Class.forName(driver);
		/* DB연결 */
		con = DriverManager.getConnection(url, user, password);
		/* 동일 아이디 검사 */
		// 기존 id동일 검사
		String chkSql = "select id from member where id=?";
		pstmt = con.prepareStatement(chkSql);
		rs = pstmt.executeQuery();
		if(rs.next()){
			idChk = true;
		}else{

			String sql = "insert into member values(?,?,?,?,?,?,?,?)";
			pstmt = con.prepareStatement(sql);
			
			
			pstmt.setString(1, id);
			pstmt.setString(2, pass);
			pstmt.setString(3, email);
			pstmt.setString(4, tel);
			pstmt.setString(5, hobbies);
			pstmt.setString(6, job);
			pstmt.setString(7, age);
			pstmt.setString(8, info);
			/* 쿼리문 실행 */
			pstmt.executeUpdate();
		}
	}catch(Exception e){
		e.printStackTrace();
	}finally{
		try{
			if(rs != null) rs.close();
			if(pstmt != null) pstmt.close();
			if(con != null) con.close();
		}catch(Exception e){ e.printStackTrace();}
	}
	
	
	
	
	
	
	//DB 연동 종료 --------------------------------------
	/* 추출한 정보 예외처리 */
	String msg = "";
	
	if(id == null || id.isEmpty()){
		msg = "회원가입을 입력하세요";
	}else if(pass == null || pass.isEmpty()){
		msg = "비밀번호를 입력하세요";
	}else if(!pass.equals(passchk)){
		msg = "비밀번호가 일치하지 않습니다";
	}else if(email == null || email.isEmpty()){
		msg = "이메일을 입력하세요";
	}else if(tel == null || tel.isEmpty()){
		msg = "전화번호를 입력하세요";
	}else if(hobbies == null || hobbies.isEmpty()){
		msg = "취미를 입력하세요";
	}else if(job == null || job.isEmpty()){
		msg = "직업을 입력하세요";
	}else if(age == null || age.isEmpty()){
		msg = "연령을 입력하세요";
	}else if(idChk){
		msg = "이미 존재하는 아이디 입니다.";
	}
	
	if(msg != null){	// 입력정보가 없는 경우
%>
		<script type="text/javascript">
			alert("<%=msg %>");
			history.go(-1);	
		</script>
<% }else {	%>	// 정상 정보인 경우 DB연결
		<script>
			alert("DB 저장 성공")
			location.href="index.jsp";
		</script>
		


<% } %>
</body>
</html>