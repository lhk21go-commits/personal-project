<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ page import="java.util.*" import="java.sql.*" %>
<%@ include file="db_conn.jsp" %>
<link rel="stylesheet" href="main.css">

	<%@ include file="header.jsp" %>
		
		<table class="form">
<%
	int nextNo = 0;

	try{
		Class.forName(driver);
		con = DriverManager.getConnection(url, user, password);
		
		String sql = "select * from member_tbl_02";
		pstmt = con.prepareStatement(sql);
		rs = pstmt.executeQuery();
		
		while(rs.next()){	%>
			<tr>
				<th>회원번호</th><th>회원성명</th><th>전화번호</th><th>주소</th><th>가입일자</th><th>고객등급</th><th>거주지역</th>
				<td>
					<a class="link" href="modForm.jsp?custno=<%=rs.getInt("custno") %>"><%=rs.getInt("custno") %></a>
				</td>
			</tr>
			<tr>
				<th>회원성명</th>
				<td>
					<input type="text" name="custname" >
				</td>
			</tr>
			<tr>
				<th>회원전화</th>
				<td>
					<input type="text" name="tel" >
				</td>
			</tr>
			<tr>
				<th>회원주소</th>
				<td>
					<input type="text" name="address" >
				</td>
			</tr>
			<tr>
				<th>가입일자</th>
				<td>
					<input type="text" name="joindate" > 예)20151202
				</td>
			</tr>
			<tr>
				<th>고객등급[A:VIP, B:일반, C:직원]</th>
				<td>
					<select name=grade>
						<option value="">선택</option>
						<option value="A">VIP</option>
						<option value="B">일반</option>
						<option value="C">직원</option>
					</select>
				</td>
			</tr>
			<tr>
				<th>도시코드</th>
				<td>
					<input type="text" name="city">
				</td>
			</tr>
			<tr>
				<td colspan="2"> 
					<input type="button" value="등 록" onclick="checkForm()">
					<input type="button" value="조 회" onclick="location.href='memberForm.jsp'">
				</td>
			</tr>
			
			
		}
				
	}catch(Exception e){
		e.printStackTrace();
	}finally{
		if(rs != null){ try{ rs.close(); } catch(Exception e){} }
		if(pstmt != null){ try{ pstmt.close(); } catch(Exception e){} }
		if(con != null){ try{ con.close(); } catch(Exception e){} }
	}

%>

	

			</table>	
		</form> 
		<script type="text/javascript">
			function checkForm(){
			let f = document.jform;
			
			if(f.custname.value == ""){
				alert("회원성명을 입력하세요!")
				f.custname.focus();
				return;
			}
			if(f.tel.value == ""){
				alert("회원전화를 입력하세요!")
				f.tel.focus();
				return;
			}
			if(f.address.value == ""){
				alert("회원주소를 입력하세요!")
				f.address.focus();
				return;
			}
			if(f.joindate.value == ""){
				alert("가입일자를 입력하세요!")
				f.joindate.focus();
				return;
			}
			if(f.grade.value == ""){
				alert("고객등급을 선택하세요!")
				f.grade.focus();
				return;
			}
			if(f.city.value == ""){
				alert("도시코드를 입력하세요!")
				f.city.focus();
				return;
			}
			f.submit();
		}
		</script>
	</section>
	
